# Competency question 4: Which female authors received Sappho in literary works before 1800, and which authority identifiers do they have?
PREFIX ecrm: <http://erlangen-crm.org/current/>
PREFIX intro: <https://w3id.org/lso/intro/currentbeta#>
PREFIX lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT (SAMPLE(?name) AS ?autorin) (MIN(?jahr) AS ?erstesJahr)
       (COUNT(DISTINCT ?text) AS ?texte)
       (SAMPLE(?wd) AS ?wikidata) (SAMPLE(?gnd) AS ?gndID)
WHERE {
  ?person a ecrm:E21_Person ; rdfs:label ?name ;
          ecrm:P2_has_type/rdfs:label "weiblich"@de ;
          ecrm:P14i_performed/lrmoo:R17_created ?text .
  {
    SELECT ?text
           (MIN(xsd:integer(SUBSTR(STR(?j), 1, 4))) AS ?jahr)
    WHERE {
      { ?text lrmoo:R17i_was_created_by
              /ecrm:P4_has_time-span/rdfs:label ?j }
      UNION
      { ?text lrmoo:R4i_is_embodied_in
              /lrmoo:R24i_was_created_through
              /ecrm:P4_has_time-span/rdfs:label ?j }
    } GROUP BY ?text
  }
  FILTER(?jahr < 1800)
  OPTIONAL { ?person owl:sameAs ?wd .
    FILTER(STRSTARTS(STR(?wd),
                     "https://www.wikidata.org/entity/")) }
  OPTIONAL { ?person owl:sameAs ?gnd .
    FILTER(STRSTARTS(STR(?gnd), "https://d-nb.info/gnd/")) }
}
GROUP BY ?person
ORDER BY ?erstesJahr
