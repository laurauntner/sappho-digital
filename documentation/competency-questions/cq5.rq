# Competency question 5: Which phenomena occur only in reception testimonies and not in Sappho's fragments?
PREFIX ecrm: <http://erlangen-crm.org/current/>
PREFIX intro: <https://w3id.org/lso/intro/currentbeta#>
PREFIX lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?phaenomen
       (COUNT(DISTINCT ?text) AS ?rezeptionszeugnisse)
WHERE {
  ?feature rdfs:label ?phaenomen .
  FILTER(LANG(?phaenomen) = "de")
  FILTER NOT EXISTS { ?feature a intro:INT_Interpretation }
  ?akt intro:R17_actualizesFeature ?feature ;
       intro:R18i_actualizationFoundOn ?text .
  ?text a lrmoo:F2_Expression .
  FILTER(!CONTAINS(STR(?text), "/bibl_sappho_"))
  FILTER NOT EXISTS {
    ?akt2 intro:R17_actualizesFeature ?feature ;
          intro:R18i_actualizationFoundOn ?fragment .
    FILTER(CONTAINS(STR(?fragment), "/bibl_sappho_"))
  }
}
GROUP BY ?phaenomen
ORDER BY DESC(?rezeptionszeugnisse)
LIMIT 10
