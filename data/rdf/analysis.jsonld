  {
    "@id": "https://sappho-digital.com/actualization/interpretation/bibl_b705febf_plot_efe620bf3882fa2f",
    "@type": [
      "https://w3id.org/lso/intro/currentbeta#INT2_ActualizationOfFeature"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "de",
        "@value": "Interpretation von Sappho-Stoff mit Fokus auf Sappho als Mutter von Kleis (Stoff) in SAPPHO »und dass ich dich lieben werde …«. Erinnerungen der Poetin und ihrer Hetären"
      },
