    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "de",
        "@value": "Interpretation von Sappho-Stoff mit Fokus auf Sappho als große Dichterin (Stoff) in Wie Lewfrid an eines Graffen Hoff in die Küchen kam/un Küchebub ward/wie in\n                    der meisterkoch fast Lieb gewan: weiter von seinem Wolsingen"
      },
